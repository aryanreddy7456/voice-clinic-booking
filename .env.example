# Copy this file to .env and fill in your keys. Never commit .env.
# ElevenLabs: https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# Google AI Studio: https://aistudio.google.com -> Get API key
GOOGLE_API_KEY=

# Optional overrides
# GOOGLE_MODEL=gemini-flash-lite-latest  # free tier, high daily limit; do not use gemini-2.5-flash (only ~20 calls/day free)
# Aryan's designed ElevenLabs voice (works on the free plan). Replace with your own voice ID if you fork this.
ELEVENLABS_VOICE_ID=srNoEEeV7vQZxtirv8jS
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Admin page password for http://localhost:8000/admin (staff page: appointments + saved call transcripts).
# Simple demo password only, not real security. Change it to anything you like.
ADMIN_TOKEN=clinic-admin-123
